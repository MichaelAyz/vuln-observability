{
  "title": "Blackbox Exporter \u2014 Uptime & SSL",
  "uid": "blackbox",
  "refresh": "60s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "title": "Probe Success Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "avg(probe_success{job=~\"blackbox-.*\"})",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "instant": true
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 1.0 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "title": "Uptime Timeline",
      "type": "state-timeline",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "probe_success{job=~\"blackbox-.*\"}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "legendFormat": "{{ $labels.instance }}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "title": "HTTP Response Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "probe_http_duration_seconds{job=\"blackbox-http\", phase=\"processing\"}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "legendFormat": "{{ $labels.instance }} (processing)"
        },
        {
          "expr": "probe_http_duration_seconds{job=\"blackbox-http\", phase=\"tls\"}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "B",
          "legendFormat": "{{ $labels.instance }} (tls)"
        },
        {
          "expr": "probe_http_duration_seconds{job=\"blackbox-http\", phase=\"connect\"}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "C",
          "legendFormat": "{{ $labels.instance }} (connect)"
        },
        {
          "expr": "probe_http_duration_seconds{job=\"blackbox-http\", phase=\"resolve\"}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "D",
          "legendFormat": "{{ $labels.instance }} (dns)"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          }
        }
      }
    },
    {
      "title": "SSL Certificate Expiry",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "legendFormat": "{{ $labels.instance }}",
          "instant": true
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 14 },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 60 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "title": "HTTP Status Code",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "targets": [
        {
          "expr": "probe_http_status_code{job=\"blackbox-http\"}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "legendFormat": "{{ $labels.instance }}",
          "instant": true
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "title": "DNS Lookup Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "targets": [
        {
          "expr": "probe_dns_lookup_time_seconds{job=\"blackbox-http\"}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "legendFormat": "{{ $labels.instance }}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ]
}