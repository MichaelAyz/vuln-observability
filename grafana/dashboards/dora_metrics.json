{
  "title": "DORA Metrics \u2014 Engineering Performance",
  "uid": "dora",
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "title": "Deployment Frequency",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(github_actions_run_total{conclusion=\"success\", repo=\"hngprojects/vulnwatch-ui\"}[30d]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "text",
      "title": "DORA Classification",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "options": {
        "content": "Elite = multiple per day\nHigh = once per day to once per week\nMedium = once per week to once per month\nLow = less than once per month",
        "mode": "markdown"
      }
    },
    {
      "title": "Lead Time for Changes",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "avg(github_actions_run_duration_seconds{repo=\"hngprojects/vulnwatch-ui\", conclusion=\"success\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Change Failure Rate (%)",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(github_actions_run_total{conclusion=\"failure\", repo=\"hngprojects/vulnwatch-ui\"}[30d])) / sum(rate(github_actions_run_total{repo=\"hngprojects/vulnwatch-ui\"}[30d])) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        }
      }
    },
    {
      "title": "MTTR (Mean Time to Restore)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "avg(github_actions_run_duration_seconds{repo=\"hngprojects/vulnwatch-ui\", conclusion=\"success\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          }
        }
      }
    },
    {
      "title": "Deployment History",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(github_actions_run_total{conclusion=\"success\", repo=\"hngprojects/vulnwatch-ui\"}[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "legendFormat": "Success"
        },
        {
          "expr": "sum(rate(github_actions_run_total{conclusion=\"failure\", repo=\"hngprojects/vulnwatch-ui\"}[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "legendFormat": "Failure"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {}
      }
    }
  ]
}