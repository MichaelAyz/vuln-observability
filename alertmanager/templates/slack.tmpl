{{/*
  ============================================================================
  slack.tmpl — Structured Alertmanager Slack notification templates
  Used by: alertmanager/alertmanager.yml receivers[].slack_configs
  Templates defined: slack.vuln.title | slack.vuln.color | slack.vuln.text

  NOTE: Alertmanager uses Go text/template — NOT Helm/Sprig.
  Functions like "default", "toUpper", "since" are NOT available.
  Only standard Go template functions plus Alertmanager builtins are valid.
  ============================================================================
*/}}


{{/* ── Title ─────────────────────────────────────────────────────────────── */}}
{{ define "slack.vuln.title" -}}
  {{- if eq .Status "firing" -}}
    [FIRING 🔴] {{ .CommonLabels.alertname }}
    {{- with .Alerts.Firing }} ({{ len . }} alert{{ if gt (len .) 1 }}s{{ end }}){{ end }}
  {{- else -}}
    [RESOLVED 🟢] {{ .CommonLabels.alertname }}
  {{- end -}}
{{ end }}


{{/* ── Color ──────────────────────────────────────────────────────────────── */}}
{{ define "slack.vuln.color" -}}
  {{- if eq .Status "resolved" -}}
    good
  {{- else if eq .CommonLabels.severity "critical" -}}
    danger
  {{- else -}}
    warning
  {{- end -}}
{{ end }}


{{/* ── Body Text ───────────────────────────────────────────────────────────── */}}
{{ define "slack.vuln.text" -}}
  {{- range $i, $alert := .Alerts }}
    {{- if gt $i 0 }}
─────────────────────────────────────────
    {{- end }}

*Severity:*  {{ if eq $alert.Labels.severity "critical" -}}
               🔴 CRITICAL
             {{- else if eq $alert.Labels.severity "warning" -}}
               🟡 WARNING
             {{- else -}}
               ℹ️  {{ $alert.Labels.severity }}
             {{- end }}
*Host:*      {{ if $alert.Labels.instance }}{{ $alert.Labels.instance }}{{ else }}N/A{{ end }}
*Summary:*   {{ if $alert.Annotations.summary }}{{ $alert.Annotations.summary }}{{ else }}No summary provided{{ end }}
*Details:*   {{ if $alert.Annotations.description }}{{ $alert.Annotations.description }}{{ else }}No description provided{{ end }}
*Started:*   {{ $alert.StartsAt }}
    {{- if $alert.Annotations.runbook_url }}
*Runbook:*   <{{ $alert.Annotations.runbook_url }}|📖 View Runbook>
    {{- end }}
    {{- if $alert.Labels.grafana_url }}
*Dashboard:* <{{ $alert.Labels.grafana_url }}|📊 Open in Grafana>
    {{- end }}
  {{- end }}
{{ end }}
