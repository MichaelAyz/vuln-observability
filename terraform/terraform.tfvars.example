ssh_private_key_path     = "../sandbox-key.pem"
vm_host                  = "3.219.30.122"
vm_user                  = "ubuntu"
slack_webhook_url        = "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
github_pat               = "ghp_your_token_here"
github_repository        = "your-username/your-repo-name"

# New dynamic parameters for fresh-server spin-up:
slack_bot_name          = "vuln-bot"
grafana_external_url    = "http://3.219.30.122:3000"
prometheus_external_url = "http://3.219.30.122:9090"

# Target probing endpoints for the Blackbox Exporter:
