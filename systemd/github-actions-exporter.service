[Unit]
Description=GitHub Actions Exporter — DORA Metrics
Documentation=https://github.com/cpanato/github-actions-exporter
After=network.target

[Service]
Type=simple
User=ghexporter
Group=ghexporter
EnvironmentFile=/etc/github-actions-exporter/env
ExecStart=/usr/local/bin/github-actions-exporter
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=github-actions-exporter

[Install]
WantedBy=multi-user.target
